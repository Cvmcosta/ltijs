{
  "name": "ltijs",
  "version": "7.0.0-beta.3",
  "description": "Easily turn your web application into a LTI 1.3 Learning Tool.",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "engineStrict": true,
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#/*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#services/*": {
      "development": "./src/services/*.ts",
      "default": "./dist/services/*.js"
    },
    "#utils/*": {
      "development": "./src/shared/utils/*.ts",
      "default": "./dist/shared/utils/*.js"
    },
    "#shared/*": {
      "development": "./src/shared/*.ts",
      "default": "./dist/shared/*.js"
    }
  },
  "scripts": {
    "prepare": "husky",
    "build:clean": "del-cli dist",
    "build:compile": "node_modules/typescript-native/bin/tsc -p tsconfig.build.json",
    "build:copy-templates": "node scripts/copy-templates.js",
    "check:format": "prettier . --write",
    "check:lint": "eslint src",
    "check:tests:unit": "jest -c jest.config.ts",
    "check:tests:db": "MONGOMS_VERSION=7.0.3 NODE_TLS_REJECT_UNAUTHORIZED=0 jest -c jest.dbconfig.ts --runInBand --passWithNoTests --forceExit",
    "test": "npm-run-all check:format check:lint check:tests:unit check:tests:db",
    "start": "tsx --conditions development src/index.ts",
    "build": "npm-run-all build:clean build:compile build:copy-templates",
    "deploy:beta": "npm-run-all test build && npm publish --tag beta",
    "deploy": "npm-run-all test build && npm publish",
    "docs:install": "cd website && npm install",
    "docs:dev": "cd website && npm run dev"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,md}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cvmcosta/ltijs.git"
  },
  "keywords": [
    "lti",
    "lms",
    "lti 1.3",
    "imslti",
    "1.3",
    "advantage"
  ],
  "author": "cvmcosta",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Cvmcosta/ltijs/issues"
  },
  "homepage": "https://cvmcosta.github.io/ltijs",
  "dependencies": {
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "parse-link-header": "^2.0.0",
    "sprightly": "^2.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/parse-link-header": "^2.0.3",
    "@types/supertest": "^7.2.1",
    "del-cli": "^7.0.0",
    "eslint": "^9.12.0",
    "eslint-config-love": "^85.0.0",
    "husky": "^9.1.7",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "lint-staged": "^17.5.0",
    "mongodb-memory-server": "^11.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-native": "npm:typescript@^7.0.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "mongodb-memory-server@11.2.0": true,
    "unrs-resolver@1.12.2": true
  }
}
